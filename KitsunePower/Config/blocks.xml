<config>

	<!--
		KitsunePower — Solar → Generator → Battery power chain
		Pure-XML retune of the vanilla power blocks, to make power lenient:
		every bank tops out at 4500W, so one full bank runs a big base.
		We do NOT add new blocks: the engine power classes (SolarPanel /
		Generator / BatteryBank) are hardcoded in Assembly-CSharp.dll, so we
		tune the vanilla blocks in place and reskin them with kitsune flavor.
		Art (models/icons) stays on the vanilla prefabs.

		The chain:
		  Solar Bank     — free daytime power source (slots solar cells)
		  Generator Bank — gas-burning power source, anytime (slots engines)
		      ...both feed downstream into...
		  Battery Bank   — the only block that STORES power, charging the
		                   car batteries you slot into it.

		Output per slot scales with the slotted item's quality: half at
		quality 1, full at quality 6. The 4500W tops below are six
		quality-6 items.
	-->

	<!-- ============================================================
	     SOLAR BANK  (vanilla: solarbank, Class=SolarPanel)
	     Slots solar cells, makes power from sunlight. Free, daytime only.
	     ============================================================ -->

	<!-- Output per solar cell: 30 -> 750 (25x). Six cells: 180W -> 4500W. -->
	<set xpath="/blocks/block[@name='solarbank']/property[@name='OutputPerStack']/@value">750</set>

	<!-- 180 -> 4500. The game works a solar bank's MaxPower out from its
	     cells on its own, so this only keeps the block's stats consistent. -->
	<set xpath="/blocks/block[@name='solarbank']/property[@name='MaxPower']/@value">4500</set>

	<!-- Custom description key (text in Localization.csv). -->
	<set xpath="/blocks/block[@name='solarbank']/property[@name='DescriptionKey']/@value">kitsuneSolarBankDesc</set>


	<!-- ============================================================
	     GENERATOR BANK  (vanilla: generatorbank, Class=Generator)
	     Slots small engines, burns gas. Anytime power source.
	     ============================================================ -->

	<!-- Output per engine: 100 -> 750 (7.5x). Six engines: 600W -> 4500W,
	     the same top as the solar and battery banks. Gas use follows the
	     power actually drawn, so this doesn't burn more gas for the same
	     base. -->
	<set xpath="/blocks/block[@name='generatorbank']/property[@name='OutputPerStack']/@value">750</set>

	<!-- Gas tank: 1000 -> 4500 (4.5x). Far fewer refuel trips. -->
	<set xpath="/blocks/block[@name='generatorbank']/property[@name='MaxFuel']/@value">4500</set>

	<!-- Power per unit of gas: 11250 -> 22500. Twice as far per gas can. -->
	<set xpath="/blocks/block[@name='generatorbank']/property[@name='OutputPerFuel']/@value">22500</set>

	<!-- The generator's internal store: 12250 -> 27000. It only burns a unit
	     of gas when a whole OutputPerFuel fits in here, so this has to be at
	     least 22500 or it never runs. 22500 + 4500 of output, the same
	     headroom vanilla leaves (11250 + 1000). -->
	<set xpath="/blocks/block[@name='generatorbank']/property[@name='MaxPower']/@value">27000</set>

	<!-- Custom description key (text in Localization.csv). -->
	<set xpath="/blocks/block[@name='generatorbank']/property[@name='DescriptionKey']/@value">kitsuneGeneratorBankDesc</set>


	<!-- ============================================================
	     BATTERY BANK  (vanilla: batterybank, Class=BatteryBank)
	     Slots car batteries and STORES power from the sources above.
	     ============================================================ -->

	<!-- How a battery bank charges: every tick it puts one unit of charge
	     into one battery, and that unit costs InputPerTick power. Each unit
	     gives OutputPerCharge power back. So InputPerTick is the price of
	     charging, not its speed. It stays at vanilla's 5: anything higher
	     costs more power for the same charge, and a source with less spare
	     than this can't charge the bank at all. -->

	<!-- Power from each unit of charge: 90 -> 180. A charged battery holds
	     twice as much, so it fills twice as fast and lasts twice as long. -->
	<set xpath="/blocks/block[@name='batterybank']/property[@name='OutputPerCharge']/@value">180</set>

	<!-- Output per battery: 50 -> 750 (15x). Six batteries: 300W -> 4500W. -->
	<set xpath="/blocks/block[@name='batterybank']/property[@name='OutputPerStack']/@value">750</set>

	<!-- The bank's internal store: 400 -> 4500, so it can keep up with
	     4500W of output. -->
	<set xpath="/blocks/block[@name='batterybank']/property[@name='MaxPower']/@value">4500</set>

	<!-- Custom description key (text in Localization.csv). -->
	<set xpath="/blocks/block[@name='batterybank']/property[@name='DescriptionKey']/@value">kitsuneBatteryBankDesc</set>

</config>
